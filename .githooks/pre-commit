#!/usr/bin/env bash
# 提交前校验改到的主题；规则见 README「提交主题」。启用：git config core.hooksPath .githooks
set -euo pipefail
dirs=$(git diff --cached --name-only --diff-filter=ACMR | sed -nE 's#^((themes|examples)/[^/]+)/.*#\1#p' | sort -u)
[ -z "$dirs" ] && exit 0
existing=()
for dir in $dirs; do [ -d "$dir" ] && existing+=("$dir"); done
[ ${#existing[@]} -eq 0 ] && exit 0
python3 tools/check.py "${existing[@]}"
